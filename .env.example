SUPBASE_URL=https://your-project.supabase.co
SUPBASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are supported alternative names.
# SUPBASE_SECRET_KEY, JWK URL, and split database fields are not used by this app.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@POOLER:5432/postgres"
# Both standard API keys and project/service-account-bound AQ.Ab... auth keys work.
# The Gemini API key carries its project association; no project/location is needed.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY is an optional fallback when GEMINI_API_KEY is absent.
# SMOKE_BASE_URL is optional for scripts/smoke.mjs; defaults to localhost:3000.
# NODE_ENV is set by Next.js; no manual value is required.
